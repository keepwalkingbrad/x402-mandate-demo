{
  "name": "x402-mandate-demo",
  "version": "0.1.0",
  "description": "Testnet demo: an AI agent pays for an x402-protected API only after checking a human-approved mandate.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:wallets": "node scripts/setup-wallets.js",
    "balance": "node --env-file=.env scripts/check-balance.js",
    "seller": "node --env-file=.env src/seller.js",
    "peek": "node scripts/peek-402.js",
    "agent": "node --env-file=.env src/agent.js",
    "demo": "node --env-file=.env src/demo.js",
    "verify-log": "node scripts/verify-log.js"
  },
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/fetch": "2.28.0",
    "express": "5.3.0",
    "viem": "2.57.8"
  }
}
